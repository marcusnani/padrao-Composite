digraph Composite {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.75", ranksep="0.80", splines=polyline];
  node [shape=record, fontname="DejaVu Sans", fontsize=11, style="filled", fillcolor="#FAFBFC", color="#303640", penwidth=1.25, margin="0.16,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#45505C", arrowsize=0.8, penwidth=1.2];
  ElementoArquivo [label="{ElementoArquivo (abstrata)|- nome: String|+ getNome(): String\l+ setNome(nome: String): void\l+ getEstrutura(): String\l}"];
  Arquivo [label="{Arquivo|- tamanhoKB: int|+ Arquivo(nome: String, tamanhoKB: int)\l+ getTamanhoKB(): int\l+ setTamanhoKB(tamanhoKB: int): void\l+ getEstrutura(): String\l}"];
  Pasta [label="{Pasta|- elementos: List\<ElementoArquivo\>|+ Pasta(nome: String)\l+ addElemento(elemento: ElementoArquivo): void\l+ getEstrutura(): String\l}"];
  GerenciadorArquivos [label="{GerenciadorArquivos|- pastaPrincipal: ElementoArquivo|+ setPastaPrincipal(pastaPrincipal: ElementoArquivo): void\l+ getEstrutura(): String\l}"];
  ElementoArquivo -> Arquivo [dir=back, arrowtail=empty];
  ElementoArquivo -> Pasta [dir=back, arrowtail=empty];
  Pasta -> ElementoArquivo [dir=both, arrowhead=none, arrowtail=diamond, label="contém 0..*", constraint=false, tailport=e, headport=e];
  GerenciadorArquivos -> ElementoArquivo [arrowhead=vee, label="raiz", style=dashed];
}
